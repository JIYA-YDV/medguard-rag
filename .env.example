# MedGuard RAG Configuration

# API Keys
OPENAI_API_KEY=sk-your-key-here

# Database
DATABASE_URL=postgresql://medguard:password@localhost:5432/medguard

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Safety
MAX_QUERY_LENGTH=500
RATE_LIMIT_PER_MINUTE=30